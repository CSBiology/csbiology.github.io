---
import JournalMeta from "./JournalMeta.astro";
import Handwritten from "../typography/Handwritten.astro";
import Scribble from "../illustration/Scribble.astro";

interface Props {
  date: string;
  title: string;
  location?: string;
  time?: string;
  subtitle?: string;
  annotation?: string;
  class?: string;
}

const { date, title, location, time, subtitle, annotation, class: className } = Astro.props;
---

<header class:list={[className]}>
  <JournalMeta date={date} location={location} time={time} />
  <h1 class="mt-3 font-body text-3xl font-semibold text-ink md:text-4xl">{title}</h1>
  {subtitle && <p class="mt-2 font-body text-lg text-ink-muted">{subtitle}</p>}
  <div class="mt-4">
    <Scribble variant="divider" class="h-3 w-32 text-line" />
  </div>
  {annotation && (
    <Handwritten size="sm" color="accent" class="mt-3 block">
      {annotation}
    </Handwritten>
  )}
</header>
